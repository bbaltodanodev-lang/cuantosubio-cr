{
  "name": "cuantosubio-cr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "assets:products": "node scripts/fetch-supermarket-images.cjs",
    "assets:brand": "node scripts/build-hero-banner-v2.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "tsx server/smoke.ssr.tsx",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.5.3",
    "prisma": "^6.15.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
